  <!-- Google Map -->
  <!-- <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAjeJEPREBQFvAIqDSZliF0WjQrCld-Mh0"></script> -->
  <script>
    document.documentElement.classList.remove('no-js');
    document.documentElement.classList.add('js');
  </script>
  <style>
    .no-js app-root {
      display: none;
    }

    .js .noscript-message {
      display: none;
    }

    .noscript-message {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      box-sizing: border-box;
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f7fa;
      color: #1f2937;
    }

    .noscript-message__content {
      max-width: 480px;
      padding: 32px;
      border-radius: 12px;
      background: #ffffff;
      box-shadow: 0 12px 30px rgba(15, 23, 42, 0.12);
      text-align: center;
    }

    .noscript-message__title {
      margin: 0 0 12px;
      font-size: 24px;
      color: #ff0000;
    }

    .noscript-message__text {
      margin: 0;
      font-size: 16px;
      line-height: 1.6;
    }
  </style>
